{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/ui/src/env.d.ts",
    "src/ui/src/**/*",
    "src/ui/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/core/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["src/ui/src/*"],
      "@renderer/*": ["src/ui/src/*"],
      "@core/*": ["src/core/*"]
    }
  }
}
